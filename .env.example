# Local: copy values from `npx supabase status -o env` (API_URL, PUBLISHABLE_KEY, SECRET_KEY)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by the seed script; never exposed to the browser.
SUPABASE_SECRET_KEY=
# Seed users (comma separated). Sign in with these via magic link.
SEED_USER_EMAILS=owner@example.com,partner@example.com

# Development only: skip the login screen and sign in as this (seeded) user.
DEV_AUTO_LOGIN_EMAIL=owner@example.com
